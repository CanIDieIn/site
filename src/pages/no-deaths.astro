---
import DeathDefinition from "@/components/DeathDefinition.astro";
import GameBrowser from "@/components/GameBrowser.astro";
import Layout from "@/layouts/Layout.astro";
import { browse } from "@/lib/browse";
import { gamesWithoutDeaths } from "@/lib/catalogue";

// Rendered per request, like the other pages. Being a fixed address, this page
// takes priority over a game whose slug happens to be "no-deaths".
export const prerender = false;

// The same search, sort and paging as the main list, over only the games
// explicitly marked as having no deaths.
const view = browse(Astro.request, Astro.url, "/no-deaths", "no-deaths");
if (view.redirect) return Astro.redirect(view.redirect, 302);
// Dates are written in the visitor's language, so caches must not share the
// page between languages.
Astro.response.headers.set("Vary", "Accept-Language");

const pageTitle = "Games You Can't Die In";
const description =
  "Every video game we have confirmed you cannot die in, so there are no deaths to count.";
const count = new Intl.NumberFormat("en");
---

<Layout title={pageTitle} description={description} tint="no">
  <main id="main" class="mx-auto w-full max-w-2xl px-5 py-14 sm:py-24">
    <header class="mb-12">
      <p class="mb-6">
        <a href="/" class="link inline-flex min-h-11 items-center">Can I Die In...</a>
      </p>
      <h1 class="text-4xl font-semibold tracking-tight text-balance sm:text-5xl">{pageTitle}</h1>
      <p class="mt-5 text-lg text-balance">
        {
          gamesWithoutDeaths.length === 1
            ? "The one game we have confirmed has no deaths to count."
            : `The ${count.format(gamesWithoutDeaths.length)} games we have confirmed have no deaths to count.`
        }
      </p>
      <DeathDefinition class="mt-5" />
    </header>

    <GameBrowser view={view} />
  </main>
</Layout>
