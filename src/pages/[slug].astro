---
import { directionOf, localePath, splitLocale } from "@/i18n/locales";
import { uiFor, type Answer } from "@/i18n/ui";
import LanguageMenu from "@/components/LanguageMenu.astro";
import Layout from "@/layouts/Layout.astro";
import {
  canDieIn,
  findGame,
  localeOfNameIn,
  nameIn,
  reasonFor,
} from "../lib/catalogue";

// Rendered per request, so no page is built for each of the 300,000 games.
export const prerender = false;

// The same page serves every language: /portal in English, /fr/portal in
// French, and so on. The text is in src/i18n/ui.ts.
const { locale } = Astro.locals;
const t = uiFor(locale);

const game = findGame(Astro.params.slug);
if (!game) Astro.response.status = 404;
// The game's name in this language, or in English if it has none.
const name = game ? nameIn(game, locale) : undefined;

// "Unsure" covers every game with no entry in deaths.json yet.
const canDie = game ? canDieIn(game) : undefined;
const answer: Answer = canDie === undefined ? "unsure" : canDie ? "yes" : "no";
// Why the game got that answer, when someone has written it down. It is in
// this language if it has been written in it, and in English otherwise.
const reason = game ? reasonFor(game, locale) : undefined;
// Where corrections are sent: the "Add or correct a game's answer" issue form
// on GitHub, in .github/ISSUE_TEMPLATE/game_answer.yml. The link fills in what
// this page already knows, so the visitor only has to give the answer and a
// reason. The link is left out while PUBLIC_GITHUB_URL is blank.
//
// Each name below other than `template` and `title` is the `id` of a field in
// that form. If a field is renamed there, rename it here too. The `kind` value
// must match one of the form's options word for word.
const githubUrl = (import.meta.env.PUBLIC_GITHUB_URL ?? "")
  .trim()
  .replace(/\/+$/, "");
const isGithubUrl =
  URL.canParse(githubUrl) && new URL(githubUrl).protocol.startsWith("http");
const correctionUrl =
  game && isGithubUrl
    ? `${githubUrl}/issues/new?${new URLSearchParams({
        template: "game_answer.yml",
        title: `Answer: ${game.name} (${game.id})`,
        kind:
          canDie === undefined
            ? "A new answer, for a game that shows Unsure"
            : "A correction, because the answer is wrong",
        "game-id": String(game.id),
        game: game.name,
      })}`
    : undefined;

const pageTitle = name ? t.game.title(name) : t.game.notFoundTitle;

// The heading asks the question in this language but may name the game in
// another, so only the name is marked, not the whole sentence. `t.game.title`
// is called with a stand-in for the name and the sentence split either side of
// it, which keeps the marked-up heading and the plain `pageTitle` in step
// without putting any HTML in src/i18n/ui.ts.
//
// The stand-in cannot appear in real text, and a translation that ever dropped
// it leaves `titleParts` unusable, in which case the heading falls back to the
// plain sentence.
const NAME_STAND_IN = "\u0000";
const nameLocale = game ? localeOfNameIn(game, locale) : locale;
const titleParts =
  name && nameLocale !== locale
    ? t.game.title(NAME_STAND_IN).split(NAME_STAND_IN)
    : undefined;

// "Browse all games" returns to the list exactly as the visitor left it, with
// their search, sort and page. The browser says which page linked here in the
// Referer header. If that was this site's main list, link back to that same
// address. A visitor who arrived any other way, such as from a search engine
// or a bookmark, gets the plain list.
//
// The link always stays in this page's language, whichever language the list
// was in.
let listHref = localePath(locale, "/");
let listLabel = t.game.browseAll;
const referrer = Astro.request.headers.get("referer");
if (referrer && URL.canParse(referrer)) {
  const from = new URL(referrer);
  if (from.host === Astro.url.host) {
    const { path } = splitLocale(from.pathname);
    if (path === "/") {
      listHref = `${localePath(locale, "/")}${from.search}`;
    } else if (path === "/no-deaths") {
      listHref = `${localePath(locale, "/no-deaths")}${from.search}`;
      listLabel = t.game.backToNoDeaths;
    }
  }
}
// The page differs by where the visitor came from, so caches must not share it.
Astro.response.headers.set("Vary", "Referer");

// The answer is set like a rubber stamp: capitals in a heavy box, knocked
// slightly off straight. Each answer has its own colour, from theme.css, and
// its own tilt. "Unsure" gets a dashed box and smaller type, as a longer word
// that also deserves less confidence.
//
// The word itself always says the answer, so colour is never the only way to
// tell them apart. `tint` is the matching wash of colour behind the page.
const stamps = {
  yes: {
    tint: "yes",
    style: "text-yes -rotate-3 text-[clamp(4rem,20vw,9rem)]",
  },
  no: { tint: "no", style: "text-no rotate-2 text-[clamp(4rem,20vw,9rem)]" },
  unsure: {
    tint: "unsure",
    style: "text-unsure -rotate-1 border-dashed text-[clamp(2.5rem,12vw,6rem)]",
  },
} as const;
const stamp = stamps[answer];

// The game's image from IGDB, laid behind the page: its official key art, or
// its cover if it has none. The layout blurs every backdrop lightly, the same
// amount whichever kind it is.
const igdbImage = (size: string, id: string) =>
  `https://images.igdb.com/igdb/image/upload/t_${size}/${id}.jpg`;
const backdrop = game?.art
  ? igdbImage("1080p", game.art)
  : game?.cover
    ? igdbImage("1080p", game.cover)
    : undefined;

// The picture for social media: the same artwork as the backdrop above, with
// the stamped answer over it, drawn by src/pages/og/[slug].jpg.ts. The stamp
// is in this page's language, so each language has its own card.
//
// Browsers and platforms keep these pictures for a long time. The `v` on the
// end names the image and the answer the card was drawn from, so if either
// changes the address changes too, and nobody is shown an out-of-date card.
const cardVersion = `${game?.art ?? game?.cover ?? "none"}-${answer}`;
const image = game
  ? `${localePath(locale, `/og/${game.slug}.jpg`)}?v=${cardVersion}`
  : undefined;
const imageAlt = name
  ? t.game.cardAlt(name, t.answers[answer].toLowerCase())
  : undefined;

const description = name
  ? t.game.description(name, t.game.answerSentence[answer])
  : undefined;
---

<Layout
  title={pageTitle}
  description={description}
  tint={stamp.tint}
  image={image}
  imageAlt={imageAlt}
  backdrop={backdrop}
  languageMenu={false}
>
  {/* The whole page is meant to be taken in without scrolling: the way back
      and the language menu along the top, the answer stamped in the middle of
      whatever room is left, and the small print along the foot. The stamp
      keeps the middle to itself, which is the point of the page.

      The menu is here rather than in the footer so it is on the first screen.
      Someone who cannot read this page should not have to scroll past it to
      find the way out. */}
  <main
    id="main"
    class="mx-auto flex min-h-dvh w-full max-w-2xl flex-col gap-6 px-5 py-6"
  >
    <div class="flex flex-wrap items-center justify-between gap-x-4 gap-y-2">
      <p>
        <a
          href={localePath(locale, "/")}
          class="link inline-flex min-h-11 items-center"
        >
          {t.siteName}
        </a>
      </p>
      <LanguageMenu />
    </div>

    <div class="flex flex-1 flex-col items-center justify-center text-center">
      {
        game ? (
          <>
            {/* The whole question in one style. It only wraps when the name is too long
                for the screen, and then breaks into lines of similar length. */}
            <h1 class="text-3xl leading-tight font-semibold tracking-tight text-balance wrap-anywhere sm:text-4xl">
              {titleParts?.length === 2 ? (
                <>
                  {titleParts[0]}
                  <span lang={nameLocale} dir={directionOf(nameLocale)}>
                    {name}
                  </span>
                  {titleParts[1]}
                </>
              ) : (
                pageTitle
              )}
            </h1>
            <p
              class:list={[
                "mt-8 mb-2 w-fit rounded-md border-[0.07em] border-current px-[0.22em] pt-[0.06em] pb-[0.1em] leading-none font-black tracking-tight uppercase",
                stamp.style,
              ]}
            >
              {t.answers[answer]}
            </p>
            {/* A reason not yet written in this language is shown in English,
                and marked as English so a screen reader pronounces it right. */}
            {reason && (
              <p
                class="mt-6 max-w-prose text-lg text-pretty"
                lang={reason.locale === locale ? undefined : reason.locale}
                dir={
                  reason.locale === locale
                    ? undefined
                    : directionOf(reason.locale)
                }
              >
                {reason.text}
              </p>
            )}
          </>
        ) : (
          <>
            <h1 class="text-3xl font-semibold tracking-tight sm:text-4xl">
              {pageTitle}
            </h1>
            <p class="mt-4 text-lg">{t.game.notFoundText}</p>
          </>
        )
      }
    </div>

    <div
      class="text-muted-foreground flex flex-col items-center gap-2 text-center text-sm"
    >
      {
        game && (
          <>
            {/* The guide to the plain-text API, in pages/streaming.astro. */}
            <p>
              {t.cards.streamingTitle}{" "}
              <a
                href={localePath(locale, "/streaming")}
                class="link text-foreground"
              >
                {t.cards.streamingText}
              </a>
              {t.fullStop}
            </p>
            {correctionUrl && (
              <p>
                {canDie === undefined ? t.game.knowAnswer : t.game.notRight}{" "}
                <a
                  href={correctionUrl}
                  rel="noopener"
                  class="link text-foreground"
                >
                  {canDie === undefined ? t.game.tellUs : t.game.suggest}
                </a>
                {t.fullStop}
                <br />
                {t.game.gameId(game.id)}
              </p>
            )}
          </>
        )
      }
      <p>
        <a href={listHref} class="link inline-flex min-h-11 items-center"
          >{listLabel}</a
        >
      </p>
    </div>
  </main>
</Layout>
