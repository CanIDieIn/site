---
import Stamp from "@/components/Stamp.astro";
import { localePath } from "@/i18n/locales";
import { streamingTextFor, type StreamingText } from "@/i18n/streaming";
import { uiFor } from "@/i18n/ui";
import Layout from "@/layouts/Layout.astro";
import { canDieIn, findGame, findGameByName } from "@/lib/catalogue";

// The guide to the plain-text API in api/[...slug].ts, for people setting up a
// stream bot. Being a fixed address, this page takes priority over a game whose
// slug happens to be "streaming".
//
// The same page serves every language: /streaming in English, /fr/streaming in
// French, and so on. Its text is in src/i18n/streaming.ts. The API itself has
// one address and one set of replies, whatever the language.
//
// Rendered per request, like the other pages, so the example answers below
// always match what the API says today.
export const prerender = false;

const { locale } = Astro.locals;
const t = streamingTextFor(locale);
const site = uiFor(locale);

const origin = (Astro.site ?? Astro.url).origin;
const api = `${origin}/api/`;

// Names to show in the examples table. `path` is how the name looks in an
// address when it differs from the name itself, and `note` names the entry in
// streaming.ts that says what the example demonstrates. The answer beside each
// one is looked up now, the same way the API does it, so the table cannot go
// out of date.
const examples: {
  name: string;
  path?: string;
  note: keyof StreamingText["matching"]["notes"];
}[] = [
  { name: "Firewatch", note: "plain" },
  {
    name: "Pokémon Red Version",
    path: "Pok%C3%A9mon%20Red%20Version",
    note: "accent",
  },
  {
    name: "Animal Crossing: New Horizons",
    path: "Animal%20Crossing:%20New%20Horizons",
    note: "punctuation",
  },
  {
    name: "Friday Night Funkin'",
    path: "Friday%20Night%20Funkin'",
    note: "apostrophe",
  },
  { name: "Baldur's Gate 3", path: "Baldur's%20Gate%203", note: "numeral" },
  {
    name: "Forza Horizon V",
    path: "Forza%20Horizon%20V",
    note: "numeralReverse",
  },
  { name: "Fate/Grand Order", path: "Fate%2FGrand%20Order", note: "slash" },
  {
    name: "100% Orange Juice",
    path: "100%25%20Orange%20Juice",
    note: "percent",
  },
  { name: "Until Dawn", path: "Until%20Dawn", note: "shared" },
  { name: "Just Chatting", path: "Just%20Chatting", note: "notGame" },
  { name: "baldurs-gate-iii", note: "slug" },
];

const answered = examples.map((example) => {
  const game = findGame(example.name) ?? findGameByName(example.name);
  const canDie = game && canDieIn(game);
  return {
    name: example.name,
    href: `/api/${example.path ?? example.name}`,
    response: canDie === undefined ? t.matching.empty : String(canDie),
    // Each reply has the colour of its answer, as on a game's page. The reply
    // is always written out too, so colour is never the only way to tell them
    // apart.
    colour:
      canDie === undefined ? "text-unsure" : canDie ? "text-yes" : "text-no",
    note: t.matching.notes[example.note],
  };
});

// Styles shared by the headings, the panels, the commands to copy and the
// inline code.
const sectionHeading = "mt-16 text-3xl font-bold tracking-tight";
// `min-w-0` lets a panel stay inside the column when it holds a long command,
// which then scrolls sideways inside its own box.
const panel = "bg-background/60 min-w-0 rounded-xl border p-5";
const botHeading = "text-lg leading-snug font-semibold";
const block =
  "bg-muted mt-3 overflow-x-auto rounded-lg border p-4 font-mono text-sm leading-relaxed";
const inline = "bg-muted rounded px-1.5 py-0.5 font-mono text-[0.9em]";

/**
 * Adds the site's styling to the little HTML in the translated text: inline
 * code, menu names, and the link to the main list. The text is written by us,
 * in streaming.ts, so it is safe to put on the page as HTML.
 */
const rich = (html: string) =>
  html
    .replaceAll("<code>", `<code class="${inline}">`)
    .replaceAll("<strong>", `<strong class="font-semibold">`)
    .replaceAll("<a>", `<a href="${localePath(locale, "/")}" class="link">`);

// The commands to copy. Each bot has its own code for the current category,
// which goes into the question the bot asks in chat.
const nightbotGame = `$(twitch $(channel) "{{game}}")`;
const commands = {
  nightbot: `!commands add !candie ${t.bots.question(nightbotGame)} $(urlfetch ${api}$(querystring ${nightbotGame}))`,
  streamElements: `!command add !candie ${t.bots.question("$(game)")} $(customapi ${api}$(pathescape $(game)))`,
  fossabot: `${t.bots.question("$(game)")} $(customapi ${api}$(pathencode $(game)))`,
};
---

<Layout title={t.title} description={t.description}>
  <main id="main" class="mx-auto w-full max-w-2xl px-5 py-14 sm:py-24">
    <header>
      <p class="mb-6">
        <a
          href={localePath(locale, "/")}
          class="link inline-flex min-h-11 items-center"
        >
          {site.siteName}
        </a>
      </p>
      {
        /* The title, with the two answers stamped beside it. On a narrow screen
          the stamps drop below the title. */
      }
      <div class="flex flex-wrap items-center justify-between gap-x-8 gap-y-6">
        <h1
          class="max-w-sm text-5xl font-bold tracking-tight text-balance sm:text-6xl"
        >
          {t.title}
        </h1>
        <div
          class="flex items-center gap-3 text-3xl sm:text-4xl"
          aria-hidden="true"
        >
          <Stamp answer="yes" />
          <Stamp answer="no" />
        </div>
      </div>
      <p class="mt-6 text-xl text-pretty">{t.intro}</p>
    </header>

    <h2 class={sectionHeading}>{t.request.heading}</h2>
    <p class="mt-4 text-pretty">{t.request.text}</p>
    <pre
      class={block}><code>GET {api}&lt;{t.request.placeholder}&gt;</code></pre>
    <p class="mt-6 text-pretty">{t.request.repliesIntro}</p>
    {
      /* The replies themselves are what the API sends, so they are not translated. */
    }
    <dl class="mt-3 grid gap-3 sm:grid-cols-3">
      <div class={panel}>
        <dt class="text-yes font-mono text-2xl font-bold" lang="en">true</dt>
        <dd class="text-muted-foreground mt-1 text-sm">{t.request.yes}</dd>
      </div>
      <div class={panel}>
        <dt class="text-no font-mono text-2xl font-bold" lang="en">false</dt>
        <dd class="text-muted-foreground mt-1 text-sm">{t.request.no}</dd>
      </div>
      <div class={panel}>
        <dt class="text-unsure font-mono text-2xl font-bold">404</dt>
        <dd class="text-muted-foreground mt-1 text-sm">{t.request.notFound}</dd>
      </div>
    </dl>
    <p class="mt-6 text-pretty" set:html={rich(t.request.slugNote)} />

    <h2 class={sectionHeading}>{t.bots.heading}</h2>
    <p class="mt-4 text-pretty">{t.bots.intro}</p>

    <div class="mt-6 grid gap-4">
      <section class={panel}>
        <h3 class={botHeading}>Streamer.bot</h3>
        <p class="mt-2 text-pretty">{t.bots.streamerBot.intro}</p>
        <ol class="mt-3 list-decimal space-y-3 pl-6 text-pretty">
          <li set:html={rich(t.bots.streamerBot.step1)} />
          <li>
            <Fragment set:html={rich(t.bots.streamerBot.step2)} />
            <pre class={block}><code>{api}%game%</code></pre>
          </li>
        </ol>
        <p
          class="text-muted-foreground mt-3 text-sm text-pretty"
          set:html={rich(t.bots.streamerBot.after)}
        />
      </section>

      <section class={panel}>
        <h3 class={botHeading}>Nightbot</h3>
        <p class="mt-2 text-pretty" set:html={rich(t.bots.nightbot.intro)} />
        <pre class={block}><code>{commands.nightbot}</code></pre>
        <p class="text-muted-foreground mt-3 text-sm text-pretty">
          {t.bots.nightbot.noAnswer}
        </p>
      </section>

      <section class={panel}>
        <h3 class={botHeading}>StreamElements</h3>
        <p class="mt-2 text-pretty">{t.bots.streamElements.intro}</p>
        <pre class={block}><code>{commands.streamElements}</code></pre>
        <p class="text-muted-foreground mt-3 text-sm text-pretty">
          {t.bots.streamElements.noAnswer}
        </p>
      </section>

      <section class={panel}>
        <h3 class={botHeading}>Fossabot</h3>
        <p class="mt-2 text-pretty">{t.bots.fossabot.intro}</p>
        <pre class={block}><code>{commands.fossabot}</code></pre>
        <p class="text-muted-foreground mt-3 text-sm text-pretty">
          {t.bots.fossabot.noAnswer}
        </p>
      </section>

      <section class={panel}>
        <h3 class={botHeading}>{t.bots.other.heading}</h3>
        <p class="mt-2 text-pretty">{t.bots.other.text}</p>
        <pre
          class={block}><code>curl "{api}Pok%C3%A9mon%20Red%20Version"</code></pre>
      </section>
    </div>

    <h2 class={sectionHeading}>{t.matching.heading}</h2>
    <p class="mt-4 text-pretty">{t.matching.intro}</p>
    <div class="mt-6 overflow-x-auto">
      <table class="w-full text-left text-sm">
        <thead>
          <tr class="border-b">
            <th scope="col" class="py-2 pr-4 font-semibold"
              >{t.matching.nameColumn}</th
            >
            <th scope="col" class="py-2 pr-4 font-semibold"
              >{t.matching.replyColumn}</th
            >
            <th scope="col" class="py-2 font-semibold"
              >{t.matching.whyColumn}</th
            >
          </tr>
        </thead>
        <tbody>
          {
            answered.map((example) => (
              <tr class="border-b align-top">
                <th scope="row" class="py-3 pr-4 font-medium">
                  <a href={example.href} class="link" lang="en">
                    {example.name}
                  </a>
                </th>
                <td
                  class:list={[
                    "py-3 pr-4 font-mono font-bold whitespace-nowrap",
                    example.colour,
                  ]}
                >
                  {example.response}
                </td>
                <td class="text-muted-foreground py-3 text-pretty">
                  {example.note}
                </td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>
    <p
      class="text-muted-foreground border-unsure mt-8 border-l-2 pl-4 text-sm text-pretty"
    >
      <strong class="text-foreground font-semibold"
        >{t.matching.helpQuestion}</strong
      >{" "}
      <Fragment set:html={rich(t.matching.help)} />
    </p>
  </main>
</Layout>
