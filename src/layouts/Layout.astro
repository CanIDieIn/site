---
import "@/styles/starwind.css";
import { DEFAULT_LOCALE, LOCALES, LOCALE_NAMES, localePath } from "@/i18n/locales";
import { uiFor } from "@/i18n/ui";

// The shell every page shares: the document head, the global stylesheet, a
// "skip to content" link, a soft wash of colour behind the page and the
// language menu at the foot. Each page provides its own <main id="main">.
//
// The page's language comes from its address, by way of src/middleware.ts.
//
// `tint` picks the colour of that wash: "yes" (red), "no" (green) or "unsure"
// (grey). The colours and the strength of the wash are set in theme.css.
//
// `image` is the picture shown when the page is shared on social media or in
// a chat app, as a path on this site, with `imageAlt` describing it for
// people who cannot see it. Pages that do not set one get the site's own card,
// in the page's language.
//
// `backdrop` is the address of a picture to lay behind the whole page, such as
// a game's artwork. It is veiled in the page colour so the text over it stays
// readable, and every backdrop gets the same light blur, so no page looks
// sharper or softer than another.
interface Props {
  title: string;
  description?: string;
  tint?: "yes" | "no" | "unsure";
  image?: string;
  imageAlt?: string;
  backdrop?: string;
}
const { locale, path } = Astro.locals;
const t = uiFor(locale);
const {
  title,
  description,
  tint = "unsure",
  backdrop,
  // Drawn by scripts/make-og-assets.mjs, one for each language.
  image = locale === DEFAULT_LOCALE ? "/og.jpg" : `/og-${locale}.jpg`,
  imageAlt = `${t.siteName} ${t.tagline}`,
} = Astro.props;

// Sharing platforms need complete addresses. Use the site address from
// astro.config.mjs, or the address being visited if that is not set.
const origin = Astro.site ?? Astro.url.origin;
const pageUrl = new URL(localePath(locale, path), origin).href;
const imageUrl = new URL(image, origin).href;

// This same page in every language, for the menu at the foot of the page and
// to tell search engines the pages are translations of each other. The
// visitor's search, sort and page number are carried across.
const translations = LOCALES.map((code) => ({
  code,
  name: LOCALE_NAMES[code],
  href: `${localePath(code, path)}${Astro.url.search}`,
  url: new URL(localePath(code, path), origin).href,
}));
---

<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    <link rel="canonical" href={pageUrl} />
    {translations.map(({ code, url }) => <link rel="alternate" hreflang={code} href={url} />)}
    <link
      rel="alternate"
      hreflang="x-default"
      href={new URL(localePath(DEFAULT_LOCALE, path), origin).href}
    />

    {/* Open Graph: how the page appears when shared on Facebook, Discord, Slack, LinkedIn and others. */}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={t.siteName} />
    <meta property="og:locale" content={locale} />
    <meta property="og:title" content={title} />
    {description && <meta property="og:description" content={description} />}
    <meta property="og:url" content={pageUrl} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={imageAlt} />

    {/* The same for X, formerly Twitter, as a large picture card. */}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    {description && <meta name="twitter:description" content={description} />}
    <meta name="twitter:image" content={imageUrl} />
    <meta name="twitter:image:alt" content={imageAlt} />
  </head>
  <body class="min-h-dvh antialiased">
    {/* The first thing a keyboard user reaches. It stays hidden until focused,
        then lets them jump past everything before the page's content. */}
    <a
      href="#main"
      class="bg-background text-foreground sr-only z-50 rounded-md px-4 py-3 font-medium underline focus:not-sr-only focus:fixed focus:top-3 focus:left-3"
    >
      {t.skipToContent}
    </a>
    {/* Decoration only, behind everything and hidden from screen readers: the
        backdrop picture, then a veil of the page colour that keeps the text
        readable over it. The picture is lightly blurred, and enlarged a
        little so its soft edges fall outside the screen. */}
    {
      backdrop && (
        <div class="pointer-events-none fixed inset-0 -z-30 overflow-hidden" aria-hidden="true">
          <img
            src={backdrop}
            alt=""
            decoding="async"
            fetchpriority="low"
            referrerpolicy="no-referrer"
            class="size-full scale-105 object-cover blur-xs"
          />
        </div>
      )
    }
    {
      backdrop && (
        <div class="backdrop-veil pointer-events-none fixed inset-0 -z-20" aria-hidden="true" />
      )
    }
    {/* Decoration only: a wash of the page's colour, fading down from the top.
        It sits behind everything and is hidden from screen readers.

        A page with a backdrop picture does not get the wash as well. The
        picture already gives the page its colour, and the two stacked darken
        the page enough to take grey text below the contrast it needs. */}
    {
      !backdrop && (
        <div
          class="pointer-events-none fixed inset-0 -z-10"
          style={`background: radial-gradient(70% 55% at 50% 0%, color-mix(in oklch, var(--${tint}) var(--tint-strength), transparent), transparent 75%)`}
          aria-hidden="true"
        />
      )
    }
    <slot />
    {/* The language menu. Each language is named in its own words, and marked
        as that language so a screen reader pronounces it correctly. */}
    <footer class="mx-auto w-full max-w-2xl px-5 pb-10">
      <nav aria-label={t.languageMenu} class="border-t pt-6">
        <ul class="flex flex-wrap justify-center gap-x-5 gap-y-1 text-sm">
          {
            translations.map(({ code, name, href }) => (
              <li>
                {code === locale ? (
                  <span
                    lang={code}
                    aria-current="true"
                    class="inline-flex min-h-11 items-center font-semibold"
                  >
                    {name}
                  </span>
                ) : (
                  <a
                    {href}
                    lang={code}
                    hreflang={code}
                    class="link text-muted-foreground inline-flex min-h-11 items-center"
                  >
                    {name}
                  </a>
                )}
              </li>
            ))
          }
        </ul>
      </nav>
    </footer>
  </body>
</html>
