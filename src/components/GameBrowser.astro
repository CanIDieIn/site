---
import { Button } from "@/components/starwind/button";
import { Input } from "@/components/starwind/input";
import { Label } from "@/components/starwind/label";
import { NativeSelect, NativeSelectOption } from "@/components/starwind/native-select";
import type { BrowseView } from "@/lib/browse";
import { DEFAULT_SORT, DIRECTIONS, SORTS } from "@/lib/catalogue";

// The search form, the list of games and the page controls. Every page that
// lists games uses this, so they all search, sort and page the same way.
// The `view` comes from `browse` in lib/browse.ts.
//
// Accessibility notes, so later changes keep them:
//   - Every field has a visible label. Placeholders are not used as labels.
//   - Nothing happens until the Search button is pressed. Changing a menu
//     never reloads the page, which would disorient keyboard and screen
//     reader users.
//   - Fields and buttons are at least 44 pixels tall, for easy tapping.
//   - Links in the list are full-width rows, so the whole row is the target.
interface Props {
  view: BrowseView;
}
const { view } = Astro.props;
const { basePath, query, sort, direction, defaultDirection, page, totalPages, total, start, games } =
  view;

const count = new Intl.NumberFormat("en");

// The component library tints fields in dark mode. Keep them plain here.
const field = "bg-background dark:bg-background shadow-none";
---

<form
  method="get"
  action={basePath}
  role="search"
  aria-label="Find a game"
  class="grid gap-4 sm:grid-cols-[minmax(0,1fr)_auto_auto_auto] sm:items-end"
  data-game-search
>
  <div class="grid gap-1.5">
    <Label for="q" size="sm">Search by name</Label>
    <Input
      id="q"
      type="search"
      name="q"
      value={query}
      maxlength="100"
      autocomplete="off"
      class={field}
    />
  </div>
  <div class="grid gap-1.5 **:data-[slot=native-select-wrapper]:w-full">
    <Label for="sort" size="sm">Sort by</Label>
    <NativeSelect id="sort" name="sort" class={field}>
      {
        SORTS.map(({ value, label, defaultDirection: startsIn }) => (
          <NativeSelectOption value={value} selected={value === sort} data-direction={startsIn}>
            {label}
          </NativeSelectOption>
        ))
      }
    </NativeSelect>
  </div>
  <div class="grid gap-1.5 **:data-[slot=native-select-wrapper]:w-full">
    <Label for="dir" size="sm">Order</Label>
    <NativeSelect id="dir" name="dir" class={field}>
      {
        DIRECTIONS.map(({ value, label }) => (
          <NativeSelectOption value={value} selected={value === direction}>
            {label}
          </NativeSelectOption>
        ))
      }
    </NativeSelect>
  </div>
  <Button type="submit">Search</Button>
</form>

<p class="text-muted-foreground mt-10 text-sm">
  {
    total === 0
      ? query
        ? `No games match "${query}".`
        : "No games to show yet."
      : `Showing ${count.format(start + 1)} to ${count.format(start + games.length)} of ${count.format(total)} ${total === 1 ? "game" : "games"}${query ? ` matching "${query}"` : ""}.`
  }
  {
    query && (
      <a href={view.pageHref(1, false)} class="link text-foreground ml-1">
        Clear search
      </a>
    )
  }
</p>

{
  games.length > 0 && (
    <ul class="mt-3 border-t">
      {games.map(({ game, released }) => (
        <li class="border-b">
          <a
            href={`/${game.slug}`}
            class="group hover:bg-accent -mx-3 flex flex-col gap-0.5 rounded-md px-3 py-3 sm:flex-row sm:items-baseline sm:justify-between sm:gap-6"
          >
            <span class="min-w-0 font-medium underline-offset-4 wrap-anywhere group-hover:underline">
              {game.name}
            </span>
            {released && (
              <time class="text-muted-foreground shrink-0 text-sm tabular-nums" datetime={released.iso}>
                <span class="sr-only">Released </span>
                {released.text}
              </time>
            )}
          </a>
        </li>
      ))}
    </ul>
  )
}

{
  totalPages > 1 && (
    <nav aria-label="Pages of results" class="mt-8 flex flex-wrap items-center justify-between gap-x-6 gap-y-4">
      {page > 1 ? (
        <a href={view.pageHref(page - 1)} rel="prev" class="link inline-flex min-h-11 items-center">
          Previous<span class="sr-only"> page</span>
        </a>
      ) : (
        <span class="text-muted-foreground inline-flex min-h-11 items-center">
          Previous<span class="sr-only"> page, not available</span>
        </span>
      )}

      <form method="get" action={basePath} class="flex items-center gap-2">
        {query && <input type="hidden" name="q" value={query} />}
        {sort !== DEFAULT_SORT && <input type="hidden" name="sort" value={sort} />}
        {direction !== defaultDirection && <input type="hidden" name="dir" value={direction} />}
        <Label for="page" size="sm" class="font-normal">
          Page
        </Label>
        <Input
          id="page"
          type="number"
          name="page"
          value={page}
          min="1"
          max={totalPages}
          inputmode="numeric"
          class={`${field} w-24`}
        />
        <span class="text-sm whitespace-nowrap">of {count.format(totalPages)}</span>
        <Button type="submit" variant="outline" class={`${field} border-input`}>
          Go<span class="sr-only"> to page</span>
        </Button>
      </form>

      {page < totalPages ? (
        <a href={view.pageHref(page + 1)} rel="next" class="link inline-flex min-h-11 items-center">
          Next<span class="sr-only"> page</span>
        </a>
      ) : (
        <span class="text-muted-foreground inline-flex min-h-11 items-center">
          Next<span class="sr-only"> page, not available</span>
        </span>
      )}
    </nav>
  )
}

<script>
  // A convenience only: picking a different sort sets the Order menu to the
  // order that sort normally starts in, such as newest first for release date.
  // Nothing is submitted. The visitor still sees both menus and presses Search.
  for (const form of document.querySelectorAll<HTMLFormElement>("[data-game-search]")) {
    const sort = form.elements.namedItem("sort");
    const order = form.elements.namedItem("dir");
    if (!(sort instanceof HTMLSelectElement) || !(order instanceof HTMLSelectElement)) continue;
    sort.addEventListener("change", () => {
      const startsIn = sort.selectedOptions[0]?.dataset.direction;
      if (startsIn) order.value = startsIn;
    });
  }
</script>
