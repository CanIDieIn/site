---
import { Button } from "@/components/starwind/button";
import { Input } from "@/components/starwind/input";
import { Label } from "@/components/starwind/label";
import { NativeSelect, NativeSelectOption } from "@/components/starwind/native-select";
import { gameHref } from "@/i18n/locales";
import { uiFor } from "@/i18n/ui";
import type { BrowseView } from "@/lib/browse";
import { DEFAULT_SORT, DIRECTIONS, nameIn, SORTS } from "@/lib/catalogue";

// The search form, the list of games and the page controls. Every page that
// lists games uses this, so they all search, sort and page the same way.
// The `view` comes from `browse` in lib/browse.ts. The text is in the view's
// language, from src/i18n/ui.ts.
//
// Accessibility notes, so later changes keep them:
//   - Every field has a visible label. Placeholders are not used as labels.
//   - The list updates as the visitor types or picks from a menu, but the
//     page is never reloaded and focus never moves, which would disorient
//     keyboard and screen reader users. Only the list is replaced, and the
//     "Showing..." line announces the new count. See the script below.
//   - Without JavaScript the form still works. A Search button appears, as
//     nothing else would then send the form.
//   - Fields and buttons are at least 44 pixels tall, for easy tapping.
//   - Links in the list are full-width rows, so the whole row is the target.
interface Props {
  view: BrowseView;
}
const { view } = Astro.props;
const {
  basePath,
  locale,
  query,
  sort,
  direction,
  defaultDirection,
  page,
  totalPages,
  total,
  start,
  games,
} = view;
const t = uiFor(locale).browser;

const count = new Intl.NumberFormat(locale);

// The component library tints fields in dark mode. Keep them plain here.
const field = "bg-background dark:bg-background shadow-none";
---

<form
  method="get"
  action={basePath}
  role="search"
  aria-label={t.formLabel}
  class="bg-background/60 grid gap-4 rounded-xl border p-4 sm:grid-cols-[minmax(0,1fr)_auto_auto] sm:items-end sm:p-5"
  data-game-search
>
  <div class="grid gap-1.5">
    <Label for="q" size="sm">{t.search}</Label>
    <Input
      id="q"
      type="search"
      name="q"
      value={query}
      maxlength="100"
      autocomplete="off"
      class={field}
    />
  </div>
  <div class="grid gap-1.5 **:data-[slot=native-select-wrapper]:w-full">
    <Label for="sort" size="sm">{t.sortBy}</Label>
    <NativeSelect id="sort" name="sort" class={field}>
      {
        SORTS.map(({ value, defaultDirection: startsIn }) => (
          <NativeSelectOption value={value} selected={value === sort} data-direction={startsIn}>
            {t.sorts[value]}
          </NativeSelectOption>
        ))
      }
    </NativeSelect>
  </div>
  <div class="grid gap-1.5 **:data-[slot=native-select-wrapper]:w-full">
    <Label for="dir" size="sm">{t.order}</Label>
    <NativeSelect id="dir" name="dir" class={field}>
      {
        DIRECTIONS.map(({ value }) => (
          <NativeSelectOption value={value} selected={value === direction}>
            {t.directions[value]}
          </NativeSelectOption>
        ))
      }
    </NativeSelect>
  </div>
  {/* Only shown when JavaScript is off, when the list cannot update by itself. */}
  <noscript class="grid sm:col-span-full">
    <Button type="submit">{t.submit}</Button>
  </noscript>
</form>

<p class="text-muted-foreground mt-10 text-sm" role="status" data-game-status>
  {
    total === 0
      ? query
        ? t.noMatch(query)
        : t.none
      : t.showing(
          count.format(start + 1),
          count.format(start + games.length),
          count.format(total),
          total,
          query,
        )
  }
  {
    query && (
      <a href={view.pageHref(1, false)} class="link text-foreground ml-1">
        {t.clear}
      </a>
    )
  }
</p>

<div data-game-results class="transition-opacity motion-reduce:transition-none aria-busy:opacity-60">
  {
    games.length > 0 && (
      <ul class="mt-3 border-t">
        {games.map(({ game, released }) => (
          <li class="border-b">
            <a
              href={gameHref(locale, game.slug)}
              class="group hover:bg-accent -mx-3 flex flex-col gap-0.5 rounded-md px-3 py-3 sm:flex-row sm:items-baseline sm:justify-between sm:gap-6"
            >
              <span class="min-w-0 wrap-anywhere">
                <span class="font-medium underline-offset-4 group-hover:underline">
                  {nameIn(game, locale)}
                </span>
                {/* A game shown under its name in this language also gets its
                    English name, which is the one most people search for. */}
                {nameIn(game, locale) !== game.name && (
                  <span class="text-muted-foreground block text-sm" lang="en">
                    {game.name}
                  </span>
                )}
              </span>
              {released && (
                <time class="text-muted-foreground shrink-0 text-sm tabular-nums" datetime={released.iso}>
                  <span class="sr-only">{t.released}</span>
                  {released.text}
                </time>
              )}
            </a>
          </li>
        ))}
      </ul>
    )
  }

  {
    totalPages > 1 && (
      <nav aria-label={t.pagesNav} class="mt-8 flex flex-wrap items-center justify-between gap-x-6 gap-y-4">
        {page > 1 ? (
          <a href={view.pageHref(page - 1)} rel="prev" class="link inline-flex min-h-11 items-center">
            <span aria-hidden="true">{t.previous}</span>
            <span class="sr-only">{t.previousPage}</span>
          </a>
        ) : (
          <span class="text-muted-foreground inline-flex min-h-11 items-center">
            <span aria-hidden="true">{t.previous}</span>
            <span class="sr-only">{t.unavailable(t.previousPage)}</span>
          </span>
        )}

        <form method="get" action={basePath} class="flex items-center gap-2">
          {query && <input type="hidden" name="q" value={query} />}
          {sort !== DEFAULT_SORT && <input type="hidden" name="sort" value={sort} />}
          {direction !== defaultDirection && <input type="hidden" name="dir" value={direction} />}
          <Label for="page" size="sm" class="font-normal">
            {t.page}
          </Label>
          <Input
            id="page"
            type="number"
            name="page"
            value={page}
            min="1"
            max={totalPages}
            inputmode="numeric"
            class={`${field} w-24`}
          />
          <span class="text-sm whitespace-nowrap">{t.ofPages(count.format(totalPages))}</span>
          <Button type="submit" variant="outline" class={`${field} border-input`}>
            <span aria-hidden="true">{t.go}</span>
            <span class="sr-only">{t.goToPage}</span>
          </Button>
        </form>

        {page < totalPages ? (
          <a href={view.pageHref(page + 1)} rel="next" class="link inline-flex min-h-11 items-center">
            <span aria-hidden="true">{t.next}</span>
            <span class="sr-only">{t.nextPage}</span>
          </a>
        ) : (
          <span class="text-muted-foreground inline-flex min-h-11 items-center">
            <span aria-hidden="true">{t.next}</span>
            <span class="sr-only">{t.unavailable(t.nextPage)}</span>
          </span>
        )}
      </nav>
    )
  }
</div>

<script>
  // Updates the list as the visitor types or picks from a menu, so there is no
  // Search button to press. Without JavaScript one is shown, and pressing it
  // loads the page the ordinary way.
  //
  // The new list is fetched from this same page's address and put in place of
  // the old one. The page is not reloaded, so the search box keeps its focus
  // and the visitor's place on the page does not move. The address bar is kept
  // in step, so the view can be bookmarked, shared or returned to.

  // How long to wait after the last keystroke before searching, in
  // milliseconds. Menus update at once.
  const TYPING_DELAY = 300;

  const form = document.querySelector<HTMLFormElement>("[data-game-search]");
  const status = document.querySelector<HTMLElement>("[data-game-status]");
  const results = document.querySelector<HTMLElement>("[data-game-results]");
  const search = form?.elements.namedItem("q");
  const sort = form?.elements.namedItem("sort");
  const order = form?.elements.namedItem("dir");

  if (
    form &&
    status &&
    results &&
    search instanceof HTMLInputElement &&
    sort instanceof HTMLSelectElement &&
    order instanceof HTMLSelectElement
  ) {
    let timer: number | undefined;
    let request: AbortController | undefined;
    // What the list currently shows, to skip a fetch that would change nothing.
    const choices = () =>
      new URLSearchParams({ q: search.value, sort: sort.value, dir: order.value }).toString();
    let shown = choices();

    /** Shows the list for the form as it stands. `force` skips the "nothing changed" check. */
    const update = async (force = false) => {
      window.clearTimeout(timer);
      const wanted = choices();
      if (wanted === shown && !force) return;

      // Only the latest request matters. Drop any still on its way.
      request?.abort();
      request = new AbortController();
      const { signal } = request;
      results.setAttribute("aria-busy", "true");
      try {
        const response = await fetch(`${form.action}?${wanted}`, { signal });
        if (!response.ok) throw new Error(`Search responded ${response.status}`);
        const page = new DOMParser().parseFromString(await response.text(), "text/html");
        const newStatus = page.querySelector("[data-game-status]");
        const newResults = page.querySelector("[data-game-results]");
        if (!newStatus || !newResults) throw new Error("Search returned an unexpected page");
        // The status line is announced by screen readers when it changes, so
        // they hear how many games now match.
        status.innerHTML = newStatus.innerHTML;
        results.innerHTML = newResults.innerHTML;
        shown = wanted;
        // The server redirects to the tidiest form of the address. Show that.
        history.replaceState(null, "", response.url);
      } catch {
        if (signal.aborted) return; // replaced by a newer request
        // Fall back to loading the page the ordinary way.
        form.submit();
        return;
      }
      results.removeAttribute("aria-busy");
    };

    search.addEventListener("input", () => {
      window.clearTimeout(timer);
      timer = window.setTimeout(() => update(), TYPING_DELAY);
    });
    sort.addEventListener("change", () => {
      // Picking a different sort sets the Order menu to the order that sort
      // normally starts in, such as newest first for release date.
      const startsIn = sort.selectedOptions[0]?.dataset.direction;
      if (startsIn) order.value = startsIn;
      update();
    });
    order.addEventListener("change", () => update());
    // Pressing Enter updates in place too, without waiting. It always runs,
    // as it also returns a visitor on a later page to page 1.
    form.addEventListener("submit", (event) => {
      event.preventDefault();
      update(true);
    });
  }
</script>
