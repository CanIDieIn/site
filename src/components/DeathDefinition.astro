---
// The site's definition of dying, in one place so every page words it the same
// way. It is set as a footnote: small monospace type beside a ruled line.
//
// Keep it this simple. The same rule decides every answer in deaths.json:
// would it make a fun moment to call this a death?
interface Props {
  class?: string;
}
const { class: className } = Astro.props;
---

<p
  class:list={[
    "border-foreground text-muted-foreground border-l-2 pl-3 font-mono text-xs leading-relaxed text-pretty",
    className,
  ]}
>
  <strong class="text-foreground font-medium tracking-wider uppercase">What counts as dying?</strong
  >{" "}
  Anything that would be fun to call a death. Killed, knocked out, blown up, game over: it all counts.
</p>
